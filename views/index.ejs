    // ── File upload ────────────────────────────────────────────────────────────
    (function () {
      const form = document.getElementById('pdfUploadForm');
      const fileInput = document.getElementById('pdfFile');
      const button = document.getElementById('pdfUploadBtn');
      const statusEl = document.getElementById('pdfUploadStatus');

      if (!form || !fileInput || !button || !statusEl) return;

      function setStatus(text, isError) {
        statusEl.textContent = text;
        statusEl.className = `text-sm min-h-[1.25rem] ${isError ? 'text-red-600' : 'text-gray-600'}`;
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        const files = Array.from(fileInput.files || []);
        if (files.length === 0) { setStatus('Please select at least one file first.', true); return; }

        button.disabled = true;
        setStatus(`Uploading ${files.length} file(s)…`, false);

        try {
          let uploadedCount = 0;
          let createdFileCount = 0;
          const failed = [];
          const splitMessages = [];

          for (let index = 0; index < files.length; index += 1) {
            const file = files[index];
            setStatus(`Uploading ${index + 1}/${files.length}: ${file.name}`, false);

            const formData = new FormData();
            formData.append('file', file);

            const response = await fetch('/api/files/upload', {
              method: 'POST',
              headers: fileApiHeaders(),
              body: formData,
            });

            const { raw, json } = await readApiResponse(response);
            if (!response.ok) {
              let message = 'Upload failed.';
              if (json?.message) {
                message = json.message;
              } else if (raw && raw.trim().startsWith('<')) {
                message = `Upload failed (${response.status}). Upstream returned HTML (likely Nginx/proxy).`;
              } else if (raw.trim()) {
                message = raw.trim().slice(0, 240);
              }
              failed.push(`${file.name}: ${message}`);
              continue;
            }

            if (!json || (!json.file && !Array.isArray(json.files))) {
              failed.push(`${file.name}: Upload succeeded but response was not valid JSON.`);
              continue;
            }

            uploadedCount += 1;
            if (Array.isArray(json.files) && json.files.length > 0) {
              createdFileCount += json.files.length;
              if (json.split) {
                splitMessages.push(`${file.name} split into ${json.files.length} parts`);
              }
            } else if (json.file) {
              createdFileCount += 1;
            }
          }

          if (failed.length > 0) {
            const preview = failed.slice(0, 2).join(' | ');
            const extra = failed.length > 2 ? ` (+${failed.length - 2} more)` : '';
            const splitText = splitMessages.length > 0 ? ` Split: ${splitMessages.slice(0, 2).join(' | ')}${splitMessages.length > 2 ? ` (+${splitMessages.length - 2} more)` : ''}` : '';
            setStatus(`Uploaded ${uploadedCount}/${files.length}. Created ${createdFileCount} stored file(s). Failed ${failed.length}. ${preview}${extra}${splitText}`, true);
          } else {
            const splitText = splitMessages.length > 0 ? ` ${splitMessages.join(' | ')}.` : '';
            setStatus(`Uploaded ${uploadedCount}/${files.length} file(s). Created ${createdFileCount} stored file(s).${splitText}`, false);
          }

          form.reset();
          loadFiles();
        } catch (error) {
          setStatus(error instanceof Error ? error.message : 'Upload failed.', true);
        } finally {
          button.disabled = false;
        }
      });
    })();

