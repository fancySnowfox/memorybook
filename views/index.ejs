<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Memorybook Creator - Memory organizer</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
    #chatPanel { display: flex; }
    #toolsDrawer { transform: translateX(100%); transition: transform 0.3s ease; }
    #toolsDrawer.open { transform: translateX(0); }
    #drawerOverlay { display: none; }
    #drawerOverlay.open { display: block; }
    .chat-message { max-width: 92%; overflow-wrap: anywhere; }
    @media (min-width: 640px) {
      .chat-message { max-width: 80%; }
    }
    @media (min-width: 1024px) {
      .chat-message { max-width: 72%; }
    }
    .chat-markdown table { width: 100%; border-collapse: collapse; margin: 0.75rem 0; }
    .chat-markdown th, .chat-markdown td { border: 1px solid #d1d5db; padding: 0.5rem 0.75rem; vertical-align: top; }
    .chat-markdown th { background: #f3f4f6; font-weight: 600; }
    .chat-markdown h1, .chat-markdown h2, .chat-markdown h3, .chat-markdown h4 { font-weight: 700; margin: 0.75rem 0 0.5rem; }
    .chat-markdown p { margin: 0.5rem 0; }
    .chat-markdown ul, .chat-markdown ol { margin: 0.5rem 0 0.5rem 1.25rem; }
    .chat-markdown blockquote { border-left: 4px solid #cbd5e1; padding-left: 0.75rem; color: #475569; margin: 0.75rem 0; }
    .chat-markdown pre { white-space: pre-wrap; word-break: break-word; overflow-x: auto; background: #f8fafc; border-radius: 0.5rem; padding: 0.75rem; }
    .chat-markdown code { overflow-wrap: anywhere; }
    .chat-markdown table { display: block; max-width: 100%; overflow-x: auto; }
    #filePreviewModal.hidden { display: none; }
  </style>
</head>
<body class="bg-gray-50">
  <!-- Header -->
  <header class="fixed top-0 left-0 right-0 h-16 bg-gradient-to-r from-blue-600 to-blue-700 shadow-md text-white z-50 flex items-center justify-between px-6">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/SnowfoxConsulting.png" alt="Memorybook Creator" width="48" height="48" class="w-12 h-12 object-contain">
      <span class="text-xl font-semibold">Memorybook Creator</span>
      <span id="headerUsername" class="hidden rounded-full bg-white/20 px-2.5 py-1 text-xs font-medium text-white"></span>
    </a>
    <nav class="flex items-center gap-4">
      <button id="openToolsBtn" class="flex items-center gap-2 bg-white/20 hover:bg-white/30 text-white font-medium px-4 py-2 rounded-md transition-colors text-sm">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
        </svg>
        Files &amp; Tools
      </button>
    </nav>
  </header>

  <!-- Drawer Overlay -->
  <div id="drawerOverlay" class="fixed inset-0 bg-black/40 z-40"></div>

  <div id="filePreviewModal" class="hidden fixed inset-0 z-[70] bg-black/60 p-4 sm:p-8">
    <div class="mx-auto flex h-full max-w-6xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl">
      <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4">
        <div>
          <h3 id="filePreviewTitle" class="text-base font-semibold text-gray-900">File Preview</h3>
          <p id="filePreviewMeta" class="text-xs text-gray-500"></p>
        </div>
        <button id="closeFilePreviewBtn" class="text-gray-500 hover:text-gray-700 focus:outline-none">Close</button>
      </div>
      <div id="filePreviewBody" class="min-h-0 flex-1 overflow-auto bg-gray-50 p-4"></div>
    </div>
  </div>

  <!-- Tools & Files Drawer -->
  <div id="toolsDrawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-white shadow-2xl z-50 flex flex-col overflow-y-auto">
    <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200 sticky top-0 bg-white">
      <h2 class="text-lg font-semibold text-gray-900">Files &amp; Tools</h2>
      <button id="closeToolsBtn" class="text-gray-500 hover:text-gray-700 focus:outline-none">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="p-6 space-y-8">

      <!-- Tab Headers -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex border-b border-gray-200 mb-6">
          <button id="tabVideoBtn" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-blue-600 text-blue-600 focus:outline-none" data-tab="tabVideo">
            Video Converter
          </button>
          <button id="tabAudioBtn" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 focus:outline-none" data-tab="tabAudio">
            Audio Transcription
          </button>
          <button id="tabPdfBtn" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700 focus:outline-none" data-tab="tabPdf">
            File Upload
          </button>
        </div>

        <!-- Tab: Video Converter -->
        <div id="tabVideo" class="tab-panel">
          <div class="flex flex-col items-center text-center mb-4">
            <div class="bg-blue-100 rounded-full p-4 mb-4">
              <svg class="h-10 w-10 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14m-6 4h4a2 2 0 002-2V8a2 2 0 00-2-2H9a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </div>
            <p class="text-gray-600">Convert iPad MOV to H.264 MP4 and target under 10MB.</p>
          </div>
          <form id="videoConvertForm" class="space-y-4">
            <div>
              <label for="movFile" class="block text-sm font-medium text-gray-700 mb-2">Select .MOV file</label>
              <input id="movFile" name="video" type="file" accept=".mov,video/quicktime" class="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:border-0 file:rounded-md file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" required>
            </div>
            <div>
              <label for="maxWidth" class="block text-sm font-medium text-gray-700 mb-2">Max resolution width</label>
              <select id="maxWidth" name="maxWidth" class="block w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
                <option value="">Auto (best effort for 10MB)</option>
                <option value="1920">1080p (1920px)</option>
                <option value="1280">720p (1280px)</option>
                <option value="960">960px</option>
                <option value="720">720px</option>
                <option value="640">640px</option>
                <option value="480">480px</option>
              </select>
            </div>
            <label for="storePermanently" class="flex items-center gap-2 text-sm text-gray-700">
              <input id="storePermanently" name="storePermanently" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
              Store converted MP4 permanently on server
            </label>
            <button id="convertBtn" type="submit" class="w-full bg-blue-600 hover:bg-blue-700 disabled:bg-blue-300 text-white font-medium py-2.5 px-4 rounded-md transition-colors">
              Convert and Download
            </button>
            <p id="convertStatus" class="text-sm text-gray-600 min-h-[1.25rem]"></p>
          </form>
        </div>

        <!-- Tab: Audio Transcription -->
        <div id="tabAudio" class="tab-panel hidden">
          <div class="flex flex-col items-center text-center mb-4">
            <div class="bg-emerald-100 rounded-full p-4 mb-4">
              <svg class="h-10 w-10 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18v3m0-3a6 6 0 006-6V8a6 6 0 10-12 0v4a6 6 0 006 6zm0 0a6 6 0 006-6V8a6 6 0 10-12 0v4a6 6 0 006 6z" />
              </svg>
            </div>
            <p class="text-gray-600">Upload an MP3 or WAV file and generate a transcript with Whisper.</p>
          </div>

          <form id="audioTranscribeForm" class="space-y-4">
            <div>
              <label for="audioFile" class="block text-sm font-medium text-gray-700 mb-2">Select audio file (.mp3 or .wav)</label>
              <input id="audioFile" name="audio" type="file" accept=".mp3,.wav,audio/mpeg,audio/wav,audio/x-wav" class="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:border-0 file:rounded-md file:bg-emerald-50 file:text-emerald-700 hover:file:bg-emerald-100" required>
            </div>
            <button id="audioTranscribeBtn" type="submit" class="w-full bg-emerald-600 hover:bg-emerald-700 disabled:bg-emerald-300 text-white font-medium py-2.5 px-4 rounded-md transition-colors">
              Transcribe Audio
            </button>
            <p id="audioTranscribeStatus" class="text-sm text-gray-600 min-h-[1.25rem]"></p>
            <div>
              <label for="audioTranscribeOutput" class="block text-sm font-medium text-gray-700 mb-2">Transcript</label>
              <textarea id="audioTranscribeOutput" rows="8" class="block w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-2 text-sm text-gray-800" placeholder="Transcript will appear here after upload." readonly></textarea>
              <p id="audioTranscribeMeta" class="mt-2 text-xs text-gray-500"></p>
            </div>
          </form>
        </div>

        <!-- Tab: File Upload -->
        <div id="tabPdf" class="tab-panel hidden">
          <div class="flex flex-col items-center text-center mb-4">
            <div class="bg-red-100 rounded-full p-4 mb-4">
              <svg class="h-10 w-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
              </svg>
            </div>
            <p class="text-gray-600">Upload documents, text files, CSVs, and images. Files over 50MB auto-split for PDF, PPTX (slide-based), and text-like formats when possible.</p>
          </div>
          <form id="pdfUploadForm" class="space-y-4">
            <div>
              <label for="pdfFile" class="block text-sm font-medium text-gray-700 mb-2">Select PDF, DOCX, PPTX, XLSX, CSV, TXT, RTF, or image file(s)</label>
              <input id="pdfFile" name="file" type="file" multiple accept=".pdf,.docx,.pptx,.xlsx,.csv,.txt,.rtf,.png,.jpg,.jpeg,.gif,.webp,text/csv,text/plain,application/rtf,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.presentationml.presentation,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,image/png,image/jpeg,image/gif,image/webp" class="block w-full text-sm text-gray-700 file:mr-4 file:py-2 file:px-4 file:border-0 file:rounded-md file:bg-red-50 file:text-red-700 hover:file:bg-red-100" required>
            </div>
            <button id="pdfUploadBtn" type="submit" class="w-full bg-red-600 hover:bg-red-700 disabled:bg-red-300 text-white font-medium py-2.5 px-4 rounded-md transition-colors">
              Upload File
            </button>
            <p id="pdfUploadStatus" class="text-sm text-gray-600 min-h-[1.25rem]"></p>
          </form>
        </div>
      </div>

      <!-- File Browser -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V7z" />
            </svg>
            My Files
            <span id="sessionLabel" class="text-xs font-normal text-gray-400 bg-gray-100 px-2 py-0.5 rounded font-mono"></span>
          </h2>
          <div class="flex items-center gap-3">
            <button id="resetFolderBtn" class="text-xs text-amber-600 hover:text-amber-700">Reset</button>
            <button id="refreshFilesBtn" class="text-xs text-blue-600 hover:text-blue-800 flex items-center gap-1">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              Refresh
            </button>
          </div>
        </div>
        <div id="fileList">
          <p class="text-gray-400 text-sm text-center py-8">Loading files…</p>
        </div>
      </div>

      <!-- Stored Converted Videos -->
      <div class="bg-white rounded-lg shadow-md p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-gray-900 flex items-center gap-2">
            <svg class="h-5 w-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14m-6 4h4a2 2 0 002-2V8a2 2 0 00-2-2H9a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            Stored Converted Videos
          </h2>
          <button id="refreshStoredVideosBtn" class="text-xs text-blue-600 hover:text-blue-800 flex items-center gap-1">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            Refresh
          </button>
        </div>
        <div id="storedVideoList">
          <p class="text-gray-400 text-sm text-center py-8">Loading converted videos…</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Main Content -->
  <div class="pt-16 min-h-screen bg-gray-50 flex flex-col">
    <!-- Title Banner -->
    <div class="text-center py-8 bg-gray-50 border-b border-gray-200">
      <h1 class="text-4xl font-bold text-gray-900 mb-2">Memorybook Creator AI</h1>
      <p class="text-lg text-gray-600">Create and organize your memories with intelligent AI</p>
    </div>
    <div id="authPanel" class="border-b border-gray-200 bg-white px-4 py-4 sm:px-6">
      <div class="mx-auto flex max-w-6xl flex-col gap-4 rounded-2xl border border-gray-200 bg-white p-4 shadow-sm lg:flex-row lg:items-start lg:justify-between">
        <div>
          <p class="text-sm font-semibold text-gray-900">Account</p>
          <p id="authStatusText" class="mt-1 text-sm text-gray-600">Checking login status…</p>
          <p id="authHint" class="mt-1 text-xs text-gray-500">Sign in to keep uploads and indexing under your account across browsers.</p>
        </div>
        <div class="w-full max-w-2xl space-y-3">
          <form id="authForm" class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto_auto]">
            <input id="authUsername" type="text" autocomplete="username" placeholder="Username" class="rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
            <input id="authPassword" type="password" autocomplete="current-password" placeholder="Password" class="rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
            <button id="loginBtn" type="submit" class="rounded-md bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700">Login</button>
            <button id="registerBtn" type="button" class="rounded-md border border-blue-200 bg-blue-50 px-4 py-2 text-sm font-medium text-blue-700 hover:bg-blue-100">Register</button>
          </form>
          <div id="authLoggedInActions" class="hidden flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <button id="logoutBtn" type="button" class="rounded-md border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50">Logout</button>
            <form id="changePasswordForm" class="grid flex-1 gap-3 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)_auto]">
              <input id="currentPassword" type="password" autocomplete="current-password" placeholder="Current password" class="rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
              <input id="nextPassword" type="password" autocomplete="new-password" placeholder="New password" class="rounded-md border border-gray-300 px-3 py-2 text-sm text-gray-800 focus:border-blue-500 focus:outline-none">
              <button id="changePasswordBtn" type="submit" class="rounded-md bg-slate-900 px-4 py-2 text-sm font-medium text-white hover:bg-slate-800">Change password</button>
            </form>
          </div>
          <p id="authMessage" class="min-h-[1.25rem] text-sm text-gray-500"></p>
        </div>
      </div>
    </div>
    <!-- Split Layout -->
    <div class="flex flex-1 overflow-hidden">
    <!-- Left: Chat Panel (always visible, full width) -->
    <div id="chatPanel" class="w-full bg-white shadow-lg flex flex-col">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-900">Memory organizer</h2>
        <div class="inline-flex rounded-md border border-gray-300 overflow-hidden" role="group" aria-label="Chat scope selector">
          <button id="scopeAppBtn" type="button" class="chat-scope-btn px-3 py-1.5 text-xs font-medium bg-blue-600 text-white" data-scope="app">App</button>
          <button id="scopeGeneralBtn" type="button" class="chat-scope-btn px-3 py-1.5 text-xs font-medium bg-white text-gray-700" data-scope="general">General</button>
        </div>
      </div>
      <div id="chatMessages" class="flex-1 overflow-y-auto p-6 space-y-4" style="max-height: calc(100vh - 280px);"></div>
      <form id="chatInputForm" class="border-t border-gray-200 p-4">
        <div class="flex gap-2">
          <input id="chatInput" type="text" placeholder="Ask me anything..." class="flex-1 rounded-md border border-gray-300 px-4 py-2 text-sm focus:border-blue-500 focus:outline-none" />
          <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded-md transition-colors">
            Send
          </button>
        </div>
        <p id="chatScopeLabel" class="text-xs text-blue-600 mt-2">Mode: App context (local Memorybook data first)</p>
        <p id="chatStatus" class="text-xs text-gray-500 mt-2"></p>
      </form>
    </div>

    <!-- Right: Tools and Files panel removed (now a drawer) -->
    </div>
  </div>

  <script>
    // Drawer toggle
    const toolsDrawer = document.getElementById('toolsDrawer');
    const drawerOverlay = document.getElementById('drawerOverlay');
    const filePreviewModal = document.getElementById('filePreviewModal');
    const filePreviewBody = document.getElementById('filePreviewBody');
    const filePreviewTitle = document.getElementById('filePreviewTitle');
    const filePreviewMeta = document.getElementById('filePreviewMeta');

    document.getElementById('openToolsBtn').addEventListener('click', () => {
      toolsDrawer.classList.add('open');
      drawerOverlay.classList.add('open');
      loadFiles();
      loadStoredVideos();
    });

    function closeDrawer() {
      toolsDrawer.classList.remove('open');
      drawerOverlay.classList.remove('open');
    }

    function getFileExtension(fileName) {
      const match = String(fileName || '').toLowerCase().match(/\.([^.]+)$/);
      return match ? `.${match[1]}` : '';
    }

    function filePreviewUrl(fileName) {
      return `/api/files/${encodeURIComponent(fileName)}?bid=${encodeURIComponent(getBrowserOwnerId())}&preview=1`;
    }

    function closeFilePreview() {
      filePreviewModal.classList.add('hidden');
      filePreviewBody.innerHTML = '';
      filePreviewTitle.textContent = 'File Preview';
      filePreviewMeta.textContent = '';
    }

    async function openFilePreview(file) {
      const ext = getFileExtension(file.originalName || file.name);
      const previewUrl = filePreviewUrl(file.name);
      const supportedTextTypes = new Set(['.txt', '.csv', '.json', '.md', '.rtf']);
      const supportedImageTypes = new Set(['.png', '.jpg', '.jpeg', '.gif', '.webp']);
      const supportedVideoTypes = new Set(['.mp4', '.mov', '.webm']);

      filePreviewTitle.textContent = file.originalName || file.name;
      filePreviewMeta.textContent = `${(Number(file.size) / (1024 * 1024)).toFixed(2)} MB`;
      filePreviewBody.innerHTML = '<p class="text-sm text-gray-500">Loading preview…</p>';
      filePreviewModal.classList.remove('hidden');

      if (ext === '.pdf') {
        filePreviewBody.innerHTML = `<iframe src="${previewUrl}" class="h-full min-h-[70vh] w-full rounded-lg border border-gray-200 bg-white"></iframe>`;
        return;
      }

      if (supportedImageTypes.has(ext)) {
        filePreviewBody.innerHTML = `<div class="flex min-h-[70vh] items-center justify-center"><img src="${previewUrl}" alt="${escapeHtml(file.originalName || file.name)}" class="max-h-[70vh] max-w-full rounded-lg border border-gray-200 bg-white object-contain"></div>`;
        return;
      }

      if (supportedVideoTypes.has(ext)) {
        filePreviewBody.innerHTML = `<div class="flex min-h-[70vh] items-center justify-center"><video controls class="max-h-[70vh] max-w-full rounded-lg bg-black"><source src="${previewUrl}"></video></div>`;
        return;
      }

      if (supportedTextTypes.has(ext)) {
        try {
          const response = await fetch(previewUrl, { headers: fileApiHeaders() });
          const text = await response.text();
          if (!response.ok) {
            throw new Error(text || 'Failed to load preview.');
          }

          if (ext === '.csv') {
            const rows = text.split(/\r?\n/).filter(Boolean).slice(0, 200).map((line) => line.split(','));
            const header = rows[0] || [];
            const bodyRows = rows.slice(1);
            const table = document.createElement('table');
            table.className = 'min-w-full border-collapse bg-white text-sm';
            table.innerHTML = `
              <thead><tr>${header.map((cell) => `<th class="border border-gray-200 bg-gray-100 px-3 py-2 text-left font-medium">${escapeHtml(cell)}</th>`).join('')}</tr></thead>
              <tbody>${bodyRows.map((row) => `<tr>${row.map((cell) => `<td class="border border-gray-200 px-3 py-2 align-top">${escapeHtml(cell)}</td>`).join('')}</tr>`).join('')}</tbody>
            `;
            filePreviewBody.innerHTML = '';
            filePreviewBody.appendChild(table);
          } else {
            filePreviewBody.innerHTML = `<pre class="whitespace-pre-wrap rounded-lg border border-gray-200 bg-white p-4 text-sm text-gray-800">${escapeHtml(text)}</pre>`;
          }
        } catch (error) {
          filePreviewBody.innerHTML = `<p class="text-sm text-red-600">${escapeHtml(error instanceof Error ? error.message : 'Failed to load preview.')}</p>`;
        }
        return;
      }

      if (ext === '.pptx') {
        filePreviewBody.innerHTML = `
          <div class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-sm text-gray-700">
            <p class="mb-3">PPTX cannot be previewed directly in this browser.</p>
            <div class="flex items-center gap-3">
              <button id="convertPptxPreviewBtn" class="rounded-md bg-blue-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-blue-700">Convert to PDF & Preview</button>
              <a href="/api/files/${encodeURIComponent(file.name)}?bid=${encodeURIComponent(getBrowserOwnerId())}" class="text-blue-600 hover:text-blue-800" download>Download original</a>
            </div>
            <p class="mt-3 text-xs text-gray-500">Requires LibreOffice on the server.</p>
          </div>
        `;

        const convertBtn = document.getElementById('convertPptxPreviewBtn');
        if (convertBtn) {
          convertBtn.addEventListener('click', async () => {
            convertBtn.disabled = true;
            convertBtn.textContent = 'Converting…';
            try {
              const response = await fetch(`/api/files/${encodeURIComponent(file.name)}/preview-pdf`, {
                method: 'POST',
                headers: fileApiHeaders(),
              });
              const { raw, json } = await readApiResponse(response);
              if (!response.ok) {
                let message = 'Failed to convert PPTX for preview.';
                if (json?.message) {
                  message = json.message;
                } else if (raw && raw.trim()) {
                  message = raw.trim().slice(0, 240);
                }
                throw new Error(message);
              }

              const pdfName = json?.file?.name;
              if (!pdfName) {
                throw new Error('Conversion finished but no preview PDF was returned.');
              }

              const pdfPreviewUrl = filePreviewUrl(pdfName);
              filePreviewTitle.textContent = json?.file?.originalName || pdfName;
              filePreviewMeta.textContent = `${(Number(json?.file?.size || 0) / (1024 * 1024)).toFixed(2)} MB · converted from PPTX`;
              filePreviewBody.innerHTML = `<iframe src="${pdfPreviewUrl}" class="h-full min-h-[70vh] w-full rounded-lg border border-gray-200 bg-white"></iframe>`;
            } catch (error) {
              filePreviewBody.innerHTML = `<p class="text-sm text-red-600">${escapeHtml(error instanceof Error ? error.message : 'Failed to convert PPTX for preview.')}</p>`;
            }
          });
        }
        return;
      }

      filePreviewBody.innerHTML = `
        <div class="rounded-lg border border-dashed border-gray-300 bg-white p-6 text-sm text-gray-600">
          <p class="mb-3">Preview is not available for this file type in the browser.</p>
          <a href="/api/files/${encodeURIComponent(file.name)}?bid=${encodeURIComponent(getBrowserOwnerId())}" class="text-blue-600 hover:text-blue-800" download>Download file</a>
        </div>
      `;
    }

    document.getElementById('closeToolsBtn').addEventListener('click', closeDrawer);
