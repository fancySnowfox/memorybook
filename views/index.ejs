    function exportAssistantMessageToPdf(content, pageFormat = 'a4') {
      const text = String(content || '').trim();
      if (!text) {
        alert('Nothing to export for this answer.');
        return;
      }

      if (!window.jspdf?.jsPDF) {
        alert('PDF export library failed to load. Please refresh and try again.');
        return;
      }

      const normalizedFormat = String(pageFormat || 'a4').toLowerCase() === 'letter' ? 'letter' : 'a4';

      const { jsPDF } = window.jspdf;
      const doc = new jsPDF({ unit: 'pt', format: normalizedFormat });
      const marginX = 48;
      const marginY = 52;
      const pageWidth = doc.internal.pageSize.getWidth();
      const pageHeight = doc.internal.pageSize.getHeight();
      const textWidth = pageWidth - (marginX * 2);
      let y = marginY;

      doc.setFont('helvetica', 'bold');
      doc.setFontSize(14);
      doc.text('Memorybook Creator Chat Export', marginX, y);
      y += 20;

      doc.setFont('helvetica', 'normal');
      doc.setFontSize(10);
      doc.text(`Exported: ${new Date().toLocaleString()}`, marginX, y);
      y += 18;

      const lines = doc.splitTextToSize(text, textWidth);
      doc.setFontSize(11);
      const lineHeight = 15;

      for (const line of lines) {
        if (y > pageHeight - marginY) {
          doc.addPage();
          y = marginY;
        }
        doc.text(line, marginX, y);
        y += lineHeight;
      }

      const fileName = `memorybook-answer-${normalizedFormat}-${new Date().toISOString().replace(/[:.]/g, '-')}.pdf`;
      doc.save(fileName);
    }

    function renderAssistantMessage(msgEl, content) {
      msgEl.classList.add('chat-markdown');
      msgEl.innerHTML = markdownRenderer.render(content);

      const actionsEl = document.createElement('div');
      actionsEl.className = 'mt-3 pt-2 border-t border-green-200/70 flex items-center justify-end gap-2';

      const formatLabel = document.createElement('label');
      formatLabel.className = 'text-xs text-green-800';
      formatLabel.textContent = 'Format';

      const formatSelect = document.createElement('select');
      formatSelect.className = 'text-xs rounded border border-green-300 bg-white px-2 py-1 text-green-800';
      formatSelect.innerHTML = `
        <option value="a4">A4</option>
        <option value="letter">Letter</option>
      `;

      const exportBtn = document.createElement('button');
      exportBtn.type = 'button';
      exportBtn.className = 'text-xs font-medium text-green-700 hover:text-green-900';
      exportBtn.textContent = 'Export PDF';
      exportBtn.addEventListener('click', () => {
        exportAssistantMessageToPdf(content, formatSelect.value);
      });

      actionsEl.appendChild(formatLabel);
      actionsEl.appendChild(formatSelect);
      actionsEl.appendChild(exportBtn);
      msgEl.appendChild(actionsEl);
      msgEl.dataset.rawContent = content;
    }

    document.querySelectorAll('.chat-scope-btn').forEach((btn) => {
      btn.addEventListener('click', () => setChatScope(btn.dataset.scope));
    });

    function stripWrappingQuotes(value) {
      const text = String(value || '').trim();
      if ((text.startsWith('"') && text.endsWith('"')) || (text.startsWith("'") && text.endsWith("'"))) {
        return text.slice(1, -1).trim();
      }
      return text;
    }

    function parseRenameChatCommand(message) {
      const text = String(message || '').trim();
      const bulkNamedPatterns = [
        /^rename\s+files?\s+(?:containing|with|that\s+contain)\s+(.+?)\s+to\s+(.+)$/i,
        /^rename\s+.*files?.*upload\s+folder.*(?:containing|with)\s+(.+?)\s+to\s+(.+)$/i,
        /^rename\s+some\s+files?.*(?:containing|with)\s+(.+?)\s+to\s+(.+)$/i,
        /^\/rename-bulk\s+(.+?)\s*=>\s*(.+)$/i,
      ];

      for (const pattern of bulkNamedPatterns) {
        const match = text.match(pattern);
        if (!match) {
          continue;
        }

        const containsText = stripWrappingQuotes(match[1]);
        const renameBase = stripWrappingQuotes(match[2]);
        if (!containsText || !renameBase) {
          return null;
        }

        const isRandom = /^(random|randomgenerated|random\s*generated)$/i.test(renameBase);
        return {
          mode: 'bulk_contains',
          containsText,
          renameBase,
          nameStyle: isRandom ? 'random' : 'named',
        };
      }

      const randomPatterns = [
        /^rename\s+files?\s+(?:containing|with|that\s+contain)\s+(.+?)\s+to\s+(?:random|randomgenerated|random\s*generated)$/i,
        /^\/rename-random\s+(.+)$/i,
      ];

      for (const pattern of randomPatterns) {
        const match = text.match(pattern);
        if (!match) {
          continue;
        }

        const containsText = stripWrappingQuotes(match[1]);
        if (!containsText) {
          return null;
        }

        return {
          mode: 'bulk_contains',
          containsText,
          renameBase: 'random',
          nameStyle: 'random',
        };
      }

      const patterns = [
        /^\/rename\s+(.+?)\s+to\s+(.+)$/i,
        /^rename\s+(?:file\s+)?(.+?)\s+to\s+(.+)$/i,
        /^rename\s+(?:file\s+)?(.+?)\s+as\s+(.+)$/i,
        /^rename\s+(?:the\s+)?file\s+named\s+(.+?)\s+to\s+(.+)$/i,
        /^\/rename\s+(.+?)\s*=>\s*(.+)$/i,
      ];

      for (const pattern of patterns) {
        const match = text.match(pattern);
        if (!match) {
          continue;
        }

        const oldName = stripWrappingQuotes(match[1]);
        const newName = stripWrappingQuotes(match[2]);
        if (!oldName || !newName) {
          return null;
        }

        return {
          mode: 'single',
          oldName,
          newName,
        };
      }

      return null;
    }

    function isRenameIntentMessage(message) {
      const text = String(message || '').toLowerCase();
      if (!text) {
        return false;
      }

      const hasRenameVerb = /\b(rename|renaming|rename)\b/.test(text);
      const hasFileContext = /\b(file|files|upload|folder)\b/.test(text);
      return hasRenameVerb && hasFileContext;
    }

    function randomFileToken() {
      const partA = Date.now().toString(36);
      const partB = Math.random().toString(36).slice(2, 8);
      return `${partA}-${partB}`;
    }

    function sanitizeGeneratedBase(value) {
      return String(value || '')
        .replace(/[\\/:\*\?"<>\|]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim()
        .slice(0, 200);
    }

    function extensionFromName(fileName) {
      const name = String(fileName || '');
      const idx = name.lastIndexOf('.');
      if (idx <= 0 || idx === name.length - 1) {
        return '';
      }
      return name.slice(idx);
    }

    async function renameFileFromChat(command) {
      const listResponse = await fetch('/api/files', {
        headers: fileApiHeaders(),
      });
      const listPayload = await readApiResponse(listResponse);
      if (!listResponse.ok || !listPayload.json) {
        throw new Error('Could not load file list before renaming.');
      }

      const files = Array.isArray(listPayload.json.files) ? listPayload.json.files : [];

      if (command.mode === 'bulk_contains') {
        const target = String(command.containsText || '').toLowerCase();
        const candidates = files.filter((file) => String(file.originalName || '').toLowerCase().includes(target));
        if (candidates.length === 0) {
          throw new Error(`No files found containing "${command.containsText}".`);
        }

        const generatedBase = sanitizeGeneratedBase(command.renameBase);
        if (command.nameStyle !== 'random' && !generatedBase) {
          throw new Error('Generated rename base is empty. Try a phrase like "family photo".');
        }

        const renamedPairs = [];
        for (let index = 0; index < candidates.length; index += 1) {
          const sourceFile = candidates[index];
          const ext = extensionFromName(sourceFile.originalName || sourceFile.name);
          const newName = command.nameStyle === 'random'
            ? `random-${index + 1}-${randomFileToken()}${ext}`
            : `${generatedBase}${candidates.length > 1 ? ` ${index + 1}` : ''}${ext}`;

          const renameResponse = await fetch(`/api/files/${encodeURIComponent(sourceFile.name)}/rename`, {
            method: 'POST',
            headers: {
              ...fileApiHeaders(),
              'Content-Type': 'application/json',
            },
            body: JSON.stringify({ newName }),
          });

          const renamePayload = await readApiResponse(renameResponse);
          if (!renameResponse.ok) {
            const msg = renamePayload.json?.message || renamePayload.raw || `Rename failed for ${sourceFile.originalName}.`;
            throw new Error(String(msg).trim());
          }

          const renamed = renamePayload.json?.file;
          renamedPairs.push({
            from: sourceFile.originalName,
            to: renamed?.originalName || newName,
          });
        }

        await loadFiles();
        const preview = renamedPairs.slice(0, 3).map((item) => `"${item.from}" -> "${item.to}"`).join('; ');
        const extra = renamedPairs.length > 3 ? ` (+${renamedPairs.length - 3} more)` : '';
        if (command.nameStyle === 'random') {
          return `Renamed ${renamedPairs.length} file(s) with random names. ${preview}${extra}`;
        }
        return `Renamed ${renamedPairs.length} file(s) using "${generatedBase}" naming. ${preview}${extra}`;
      }

      const byOriginalExact = files.filter((file) => file.originalName === command.oldName);
      const byStoredExact = files.filter((file) => file.name === command.oldName);
      const lcTarget = command.oldName.toLowerCase();
      const byOriginalCaseInsensitive = files.filter((file) => String(file.originalName || '').toLowerCase() === lcTarget);
      const byStoredCaseInsensitive = files.filter((file) => String(file.name || '').toLowerCase() === lcTarget);

      const candidates = byOriginalExact.length > 0
        ? byOriginalExact
        : byStoredExact.length > 0
          ? byStoredExact
          : byOriginalCaseInsensitive.length > 0
            ? byOriginalCaseInsensitive
            : byStoredCaseInsensitive;

      if (candidates.length === 0) {
        throw new Error(`File "${command.oldName}" was not found.`);
      }

      if (candidates.length > 1) {
        throw new Error(`Multiple files matched "${command.oldName}". Use the exact file name shown in My Files.`);
      }

      const sourceFile = candidates[0];
      const renameResponse = await fetch(`/api/files/${encodeURIComponent(sourceFile.name)}/rename`, {
        method: 'POST',
        headers: {
          ...fileApiHeaders(),
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ newName: command.newName }),
      });

      const renamePayload = await readApiResponse(renameResponse);
      if (!renameResponse.ok) {
        const msg = renamePayload.json?.message || renamePayload.raw || 'Rename failed.';
        throw new Error(String(msg).trim());
      }

      const renamed = renamePayload.json?.file;
      const finalName = renamed?.originalName || command.newName;
      await loadFiles();
      return `Renamed "${sourceFile.originalName}" to "${finalName}".`;
    }

    async function sendChatMessage() {
      const input = document.getElementById('chatInput');
      const message = input.value.trim();
      if (!message) return;

      input.value = '';
      addChatMessage(message, 'user');

      const statusEl = document.getElementById('chatStatus');
      statusEl.textContent = 'Thinking...';

      conversationHistory.push({ role: 'user', content: message });

      const renameCommand = parseRenameChatCommand(message);
      if (renameCommand) {
        try {
          if (renameCommand.mode === 'bulk_contains') {
            statusEl.textContent = renameCommand.nameStyle === 'random'
              ? 'Renaming matching files with random names...'
              : 'Renaming matching files with generated names...';
          } else {
            statusEl.textContent = 'Renaming file...';
          }
          const result = await renameFileFromChat(renameCommand);
          addChatMessage(result, 'assistant');
          conversationHistory.push({ role: 'assistant', content: result });
          statusEl.textContent = '';
        } catch (error) {
          const errorMessage = error instanceof Error ? error.message : 'Rename failed.';
          addChatMessage(`Rename failed: ${errorMessage}`, 'error');
          conversationHistory.push({ role: 'assistant', content: `Rename failed: ${errorMessage}` });
          statusEl.textContent = '';
        }
        return;
      }

      if (isRenameIntentMessage(message)) {
        const help = [
          'I can rename files in your upload folder directly from chat. Try one of these:',
          '1) rename file "old-name.pdf" to "new-name.pdf"',
          '2) rename files containing "IMG_" to "Family Photo"',
          '3) rename files in upload folder containing "draft" to "Client Proposal"',
          '4) /rename-random "IMG_"',
        ].join('\n');
        addChatMessage(help, 'assistant');
        conversationHistory.push({ role: 'assistant', content: help });
        statusEl.textContent = '';
        return;
      }

      try {
        const response = await fetch('/api/chat', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-Browser-Id': getBrowserOwnerId(),
          },
          body: JSON.stringify({ messages: conversationHistory, scope: chatScope }),
        });

        if (!response.ok) {
          throw new Error(`API error: ${response.status}`);
        }

        const contentType = (response.headers.get('content-type') || '').toLowerCase();
        let assistantMessage = '';

        // Current backend returns plain text. Keep SSE parsing as a fallback for compatibility.
        if (contentType.includes('text/plain')) {
          assistantMessage = await response.text();
          addChatMessage(assistantMessage || '(empty response)', 'assistant');
        } else {
          const reader = response.body.getReader();
          const decoder = new TextDecoder();
          let messageEl = null;
          let buffered = '';

          while (true) {
            const { done, value } = await reader.read();
            if (done) break;

            buffered += decoder.decode(value, { stream: true });
            const lines = buffered.split('\n');
            buffered = lines.pop() || '';

            for (const line of lines) {
              if (!line.startsWith('data: ')) continue;
              try {
                const data = JSON.parse(line.slice(6));
                if (data.delta?.content) {
                  assistantMessage += data.delta.content;
                  if (!messageEl) {
                    messageEl = addChatMessage('', 'assistant');
                  }
                  renderAssistantMessage(messageEl, assistantMessage);
                  document.getElementById('chatMessages').scrollTop = document.getElementById('chatMessages').scrollHeight;
                }
              } catch (e) { /* ignore malformed stream chunks */ }
            }
          }

          if (!assistantMessage && buffered.trim().length > 0) {
            assistantMessage = buffered.trim();
            addChatMessage(assistantMessage, 'assistant');
          }
        }

        conversationHistory.push({ role: 'assistant', content: assistantMessage || '(empty response)' });
        statusEl.textContent = '';
      } catch (error) {
        addChatMessage(`Error: ${error.message}`, 'error');
        statusEl.textContent = '';
      }
    }

    function addChatMessage(content, role) {
      const messagesEl = document.getElementById('chatMessages');
      const msgEl = document.createElement('div');
      const bgClass = role === 'user' ? 'bg-blue-100 text-blue-900 ml-auto' : role === 'error' ? 'bg-red-100 text-red-900' : 'bg-green-100 text-green-900';
      msgEl.className = `chat-message p-4 rounded-lg break-words ${bgClass}`;
      if (role === 'assistant') {
        renderAssistantMessage(msgEl, content);
      } else {
        msgEl.textContent = content;
      }
      messagesEl.appendChild(msgEl);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      return msgEl;
    }

    document.getElementById('chatInputForm').addEventListener('submit', (e) => {
      e.preventDefault();
      sendChatMessage();
    });

    setChatScope('app');

    const BROWSER_OWNER_KEY = 'snowfoxBrowserOwnerId';
    let authUser = null;

  </script>
  <script>
    // Browser owner ID and file management

    function newBrowserOwnerId() {
      return `b_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 10)}`;
    }

    function getBrowserOwnerId() {
      let id = localStorage.getItem(BROWSER_OWNER_KEY);
      if (!id) {
        id = newBrowserOwnerId();
        localStorage.setItem(BROWSER_OWNER_KEY, id);
      }
      return id;
    }

    function setFolderLabel() {
      const el = document.getElementById('sessionLabel');
      if (el) {
        if (authUser?.username) {
          el.textContent = `account: ${authUser.username}`;
          el.title = authUser.username;
          return;
        }

        const id = getBrowserOwnerId();
        el.textContent = `folder: ${id.slice(0, 12)}…`;
        el.title = id;
      }

      const resetButton = document.getElementById('resetFolderBtn');
      if (resetButton) {
        resetButton.classList.toggle('hidden', Boolean(authUser?.username));
      }
    }

    function fileApiHeaders() {
      return {
        'X-Browser-Id': getBrowserOwnerId(),
      };
    }

    async function readApiResponse(response) {
      const raw = await response.text();
      const contentType = response.headers.get('content-type') || '';
      let json = null;

      if (contentType.includes('application/json')) {
        try {
          json = JSON.parse(raw);
        } catch (_) {
          json = null;
        }
      }

      return { raw, json, contentType };
    }

    function setAuthMessage(text, isError) {
      const el = document.getElementById('authMessage');
      if (!el) {
        return;
      }

      el.textContent = text || '';
      el.className = `min-h-[1.25rem] text-sm ${isError ? 'text-red-600' : 'text-gray-500'}`;
    }

    function updateAuthUi() {
      const authStatusText = document.getElementById('authStatusText');
      const authHint = document.getElementById('authHint');
      const authForm = document.getElementById('authForm');
      const authLoggedInActions = document.getElementById('authLoggedInActions');
      const authPanel = document.getElementById('authPanel');
      const headerUsername = document.getElementById('headerUsername');

      if (authStatusText) {
        authStatusText.textContent = authUser?.username
          ? `Signed in as ${authUser.username}. New uploads and indexing now use this account.`
          : 'Guest mode is active. Files stay tied to this browser until you sign in.';
      }

      if (authHint) {
        authHint.textContent = authUser?.username
          ? 'Account ownership now takes priority over the browser folder id.'
          : 'Sign in to keep uploads and indexing under your account across browsers.';
      }

      authForm?.classList.toggle('hidden', Boolean(authUser?.username));
      authLoggedInActions?.classList.toggle('hidden', !authUser?.username);

      if (headerUsername) {
        if (authUser?.username) {
          headerUsername.textContent = authUser.username;
          headerUsername.classList.remove('hidden');
        } else {
          headerUsername.textContent = '';
          headerUsername.classList.add('hidden');
        }
      }

      authPanel?.classList.toggle('hidden', Boolean(authUser?.username));
      setFolderLabel();
    }

    async function refreshAuthStatus(options = {}) {
      try {
        const response = await fetch('/api/auth/status');
        const { json } = await readApiResponse(response);
        authUser = json?.authenticated ? json.user : null;
        updateAuthUi();
        if (!options.silent) {
          setAuthMessage(authUser?.username ? 'Login status refreshed.' : '', false);
        }
      } catch {
        authUser = null;
        updateAuthUi();
        if (!options.silent) {
          setAuthMessage('Could not read login status.', true);
        }
      }
    }

    async function submitAuth(mode) {
      const username = document.getElementById('authUsername')?.value || '';
      const password = document.getElementById('authPassword')?.value || '';
      const endpoint = mode === 'register' ? '/api/auth/register' : '/api/auth/login';

      setAuthMessage(mode === 'register' ? 'Creating account…' : 'Signing in…', false);

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password }),
        });
        const { raw, json } = await readApiResponse(response);
        if (!response.ok) {
          throw new Error(json?.message || raw || 'Authentication failed.');
        }

        authUser = json?.user || null;
        document.getElementById('authPassword').value = '';
        updateAuthUi();
        setAuthMessage(mode === 'register' ? 'Account created and signed in.' : 'Signed in.', false);
        loadFiles();
        loadStoredVideos();
      } catch (error) {
        setAuthMessage(error instanceof Error ? error.message : 'Authentication failed.', true);
      }
    }

    async function logoutUser() {
      setAuthMessage('Signing out…', false);
      try {
        const response = await fetch('/api/auth/logout', { method: 'POST' });
        const { raw, json } = await readApiResponse(response);
        if (!response.ok) {
          throw new Error(json?.message || raw || 'Logout failed.');
        }

