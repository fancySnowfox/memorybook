    // ── Video converter ────────────────────────────────────────────────────────
    (function () {
      const form = document.getElementById('videoConvertForm');
      const fileInput = document.getElementById('movFile');
      const maxWidthSelect = document.getElementById('maxWidth');
      const storePermanentlyCheckbox = document.getElementById('storePermanently');
      const button = document.getElementById('convertBtn');
      const statusEl = document.getElementById('convertStatus');

      if (!form || !fileInput || !maxWidthSelect || !storePermanentlyCheckbox || !button || !statusEl) {
        return;
      }

      function setStatus(text, isError) {
        statusEl.textContent = text;
        statusEl.className = `text-sm min-h-[1.25rem] ${isError ? 'text-red-600' : 'text-gray-600'}`;
      }

      function createProgressId() {
        if (window.crypto?.randomUUID) {
          return window.crypto.randomUUID().replace(/-/g, '');
        }

        return `job${Date.now()}${Math.random().toString(36).slice(2, 10)}`;
      }

      function parseXhrHeaders(rawHeaders) {
        const headers = new Headers();
        if (!rawHeaders) {
          return headers;
        }

        rawHeaders
          .trim()
          .split(/\r?\n/)
          .forEach((line) => {
            const idx = line.indexOf(':');
            if (idx <= 0) {
              return;
            }
            const key = line.slice(0, idx).trim();
            const value = line.slice(idx + 1).trim();
            headers.append(key, value);
          });

        return headers;
      }

      function postVideoConvert(formData, handlers = {}) {
        return new Promise((resolve, reject) => {
          const xhr = new XMLHttpRequest();
          let uploadFinished = false;

          function markUploadFinished() {
            if (uploadFinished) {
              return;
            }
            uploadFinished = true;
            handlers.onUploadComplete?.();
          }

          xhr.open('POST', '/api/video/convert', true);
          xhr.setRequestHeader('X-Browser-Id', getBrowserOwnerId());
          xhr.responseType = 'blob';

          xhr.upload.addEventListener('progress', (event) => {
            handlers.onUploadProgress?.(event);
          });
          xhr.upload.addEventListener('load', markUploadFinished);
          xhr.upload.addEventListener('loadend', markUploadFinished);

          xhr.addEventListener('error', () => {
            reject(new Error('Network error during upload/conversion request.'));
          });

          xhr.addEventListener('abort', () => {
            reject(new Error('Upload/conversion request was aborted.'));
          });

          xhr.addEventListener('load', () => {
            markUploadFinished();
            resolve({
              ok: xhr.status >= 200 && xhr.status < 300,
              status: xhr.status,
              headers: parseXhrHeaders(xhr.getAllResponseHeaders()),
              blob: xhr.response,
            });
          });

          xhr.send(formData);
        });
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const file = fileInput.files && fileInput.files[0];
        if (!file) {
          setStatus('Please select a .MOV file first.', true);
          return;
        }

        button.disabled = true;
        setStatus('Converting video… this can take a minute for larger files.', false);

        const progressId = createProgressId();
        let progressPoller = null;
        let sawProgressData = false;
        let uploadCompleted = false;
        let uploadProgressSeen = false;

        async function pollProgress() {
          try {
            const progressRes = await fetch(`/api/video/convert/progress/${encodeURIComponent(progressId)}`);
            if (!progressRes.ok) {
              if (progressRes.status === 404 && !sawProgressData) {
                if (uploadCompleted) {
                  setStatus('Upload complete. Waiting for conversion to start...', false);
                } else if (!uploadProgressSeen) {
                  setStatus('Uploading file to server… conversion progress will appear shortly.', false);
                }
              }
              return;
            }

            const payload = await progressRes.json();
            const progress = payload?.progress;
            if (!progress) {
              return;
            }

            sawProgressData = true;

            if (progress.status === 'error' && progress.message) {
              setStatus(progress.message, true);
              return;
            }

            const percentText = Number.isFinite(progress.percent)
              ? `${progress.percent}%`
              : null;
            const attemptText = (progress.attempt && progress.attemptTotal)
              ? ` attempt ${progress.attempt}/${progress.attemptTotal}`
              : '';
            const speedText = progress.speed ? ` speed ${progress.speed}` : '';

            if (progress.message || percentText) {
              const base = progress.message || 'Converting...';
              const withPercent = percentText && !base.includes('%') ? `${base} ${percentText}` : base;
              setStatus(`${withPercent}${attemptText}${speedText}`, false);
            }
          } catch {
            // Ignore transient polling failures while conversion request is still running.
          }
        }


        // Polling will start after upload completes

        try {
          const formData = new FormData();
          formData.append('progressId', progressId);
          formData.append('video', file);
          if (maxWidthSelect.value) {
            formData.append('maxWidth', maxWidthSelect.value);
          }
          if (storePermanentlyCheckbox.checked) {
            formData.append('storePermanently', 'true');
          }


          const response = await postVideoConvert(formData, {
            onUploadProgress: (event) => {
              if (!event.lengthComputable || sawProgressData) {
                return;
              }
              uploadProgressSeen = true;
              const percent = Math.max(0, Math.min(100, Math.round((event.loaded / event.total) * 100)));
              setStatus(`Uploading video... ${percent}%`, false);
            },
            onUploadComplete: () => {
              uploadCompleted = true;
              if (!sawProgressData) {
                setStatus('Upload complete. Waiting for conversion to start...', false);
              }
              // Start polling only after upload is done
              progressPoller = window.setInterval(pollProgress, 1200);
              pollProgress();
            },
          });

          if (!response.ok) {
            const raw = await response.blob.text();
            let json = null;
            try {
              json = raw ? JSON.parse(raw) : null;
            } catch {
              json = null;
            }
            let message = `Conversion failed (${response.status})`;
            if (json?.message) {
              message = json.message;
            } else if (json?.error?.message) {
              message = json.error.message;
            } else if (raw && raw.trim().startsWith('<')) {
              message = `Conversion failed (${response.status}). Upstream returned HTML (likely Nginx/proxy).`;
            } else if (raw.trim()) {
              message = raw.trim().slice(0, 240);
            }
            throw new Error(message);
          }

          const blob = response.blob;
          const suggestedName = file.name.replace(/\.[^.]+$/, '') + '.mp4';
          const downloadUrl = URL.createObjectURL(blob);
          const link = document.createElement('a');
          link.href = downloadUrl;
          link.download = suggestedName;
          document.body.appendChild(link);
          link.click();
          link.remove();
          URL.revokeObjectURL(downloadUrl);

          const sizeHeader = response.headers.get('X-Output-Size-MB');
          const sizeText = sizeHeader ? ` Output size: ${sizeHeader} MB.` : '';
          const storedFile = response.headers.get('X-Stored-File');
          const storedText = storedFile ? ` Stored on server as ${storedFile}.` : '';
          setStatus(`Done.${sizeText}${storedText}`, false);
          if (storedFile) {
            loadStoredVideos();
          }
        } catch (error) {
          setStatus(error instanceof Error ? error.message : 'Conversion failed.', true);
        } finally {
          if (progressPoller) {
            window.clearInterval(progressPoller);
          }
          button.disabled = false;
        }
      });
    })();

