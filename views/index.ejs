          });

          const { raw, json } = await readApiResponse(response);
          if (!response.ok) {
            let message = 'Audio transcription failed.';
            if (json?.message) {
              message = json.message;
            } else if (raw && raw.trim().startsWith('<')) {
              message = `Audio transcription failed (${response.status}). Upstream returned HTML (likely Nginx/proxy).`;
            } else if (raw.trim()) {
              message = raw.trim().slice(0, 240);
            }
            throw new Error(message);
          }

          const transcript = typeof json?.text === 'string' ? json.text : '';
          outputEl.value = transcript;

          const segmentCount = Array.isArray(json?.segments) ? json.segments.length : 0;
          const language = json?.language || 'unknown';
          metaEl.textContent = `Language: ${language} · Segments: ${segmentCount}`;

          if (!transcript.trim()) {
            setStatus('Transcription completed, but no speech was detected in this file.', false);
          } else {
            setStatus('Transcription completed.', false);
          }
        } catch (error) {
          setStatus(error instanceof Error ? error.message : 'Audio transcription failed.', true);
