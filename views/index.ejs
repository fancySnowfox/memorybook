                if (json?.message) {
                  message = json.message;
                } else if (raw && raw.trim().startsWith('<')) {
                  message = `Delete failed (${res.status}). Upstream returned HTML (likely Nginx/proxy).`;
                } else if (raw.trim()) {
                  message = raw.trim().slice(0, 240);
                }
                throw new Error(message);
              }
              loadStoredVideos();
            } catch (error) {
              alert(error instanceof Error ? error.message : 'Delete failed.');
            }
          });
        });
      } catch (error) {
        listEl.innerHTML = `<p class="text-red-500 text-sm text-center py-8">${escapeHtml(error.message)}</p>`;
      }
    }

    function escapeHtml(str) {
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    document.getElementById('refreshFilesBtn').addEventListener('click', loadFiles);
    document.getElementById('refreshStoredVideosBtn').addEventListener('click', loadStoredVideos);
    document.getElementById('authForm').addEventListener('submit', (event) => {
      event.preventDefault();
      submitAuth('login');
    });
    document.getElementById('registerBtn').addEventListener('click', () => submitAuth('register'));
    document.getElementById('logoutBtn').addEventListener('click', logoutUser);
    document.getElementById('changePasswordForm').addEventListener('submit', submitPasswordChange);
    document.getElementById('resetFolderBtn').addEventListener('click', () => {
      if (!confirm('Create a new folder identity? You will no longer see files from the current folder in this browser.')) {
        return;
      }

      localStorage.setItem(BROWSER_OWNER_KEY, newBrowserOwnerId());
      setFolderLabel();
      loadFiles();
    });
    refreshAuthStatus({ silent: true });
    loadFiles();
    loadStoredVideos();

    // Show stable browser-owner folder ID in the header.
    setFolderLabel();
  </script>
</body>
</html>
